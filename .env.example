# Copy to .env.local and fill in what you need.
# Every value here is optional for a first local run: with no DATABASE_URL the
# app serves the in-memory mock lobby and boards.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Unset: services fall back to mocks (local only; missing in production throws).
# Set: run `npm run db:push` once to create the schema.
# DATABASE_URL=postgres://board:board@localhost:5432/board

# ---------------------------------------------------------------------------
# Chain
# ---------------------------------------------------------------------------
# Paid play launches on Robinhood Chain mainnet (chain ID 4663).
NEXT_PUBLIC_CHAIN_ENV=mainnet

# Production must use a dedicated provider endpoint. The public Robinhood RPC
# is rate-limited and is not recommended for production use.
# NEXT_PUBLIC_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# NEXT_PUBLIC_EXPLORER_URL=

# BOARD ERC-20 address, once on-chain deposits go live. It is unrelated to the
# canonical USDG paid-entry contract hardcoded by the application.
# House wallet is auto-created at `.data/play-treasury.json` on first sit.
# For production, inject a stable key and fund that address with canonical USDG
# plus native ETH for refund and payout gas.
# Optional override:
# PLAY_TREASURY_PRIVATE_KEY=
# NEXT_PUBLIC_BOARD_TOKEN_ADDRESS=

# Explicit production release gate. Leave unset until the fresh mainnet ledger,
# worker health, treasury reserves, and operational checks are approved.
# PLAY_MAINNET_ENABLED=true

# Successful entries, refunds, and payouts are final only after this many
# blocks. The application defaults to 30 when unset.
# PLAY_PAYMENT_CONFIRMATIONS=30

# Public origin, used to build absolute URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Public marketing website used by the globe/home control in the game HUD.
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Closed demo
# ---------------------------------------------------------------------------
# Access code for playable tables (lobby, rooms, wallet). Public landing stays
# open. Share `/demo?code=THIS` as the one-click project link.
DEMO_ACCESS_CODE=BOARD-CLOSED

# ---------------------------------------------------------------------------
# Wallet sign-in
# ---------------------------------------------------------------------------
# RainbowKit WalletConnect Cloud project id (https://cloud.walletconnect.com).
# Injected wallets (MetaMask, Rabby, OKX) work without it; QR / mobile need it.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Public community destinations used by the header LINKS dropdown.
# NEXT_PUBLIC_X_URL=https://x.com/YOUR_HANDLE
# NEXT_PUBLIC_TELEGRAM_URL=https://t.me/YOUR_CHANNEL
# NEXT_PUBLIC_DEXSCREENER_URL=https://dexscreener.com/CHAIN/PAIR

# Accept the literal signature "mock-signed" so you can sign in without a
# wallet. Ignored when NODE_ENV=production.
ALLOW_MOCK_WALLET_VERIFY=true

# ---------------------------------------------------------------------------
# Service-to-service
# ---------------------------------------------------------------------------
# Shared secret for the chain indexer and payout worker: the payment webhook,
# deposit confirmation, withdraw processing, and burn proofs. Unset leaves those
# endpoints open in development and refuses to serve them in production.
# PAYMENT_WEBHOOK_SECRET=local-dev-secret

# --- Testnet ---------------------------------------------------------------
# Paxos has no testnet USDG, so paid play on testnet uses a stand-in token the
# project deploys itself (contracts/script/Deploy.s.sol). Leave unset on
# mainnet, where the canonical USDG address is used.
# NEXT_PUBLIC_USDG_ADDRESS=0x02E8950B4C0EBb85dF311cBd1629023c913d9b13

# The paid ledger pins itself to one chain, treasury and stake token, and
# refuses to be reused on another. Point each network at its own directory
# when running locally; in production use a separate DATABASE_URL instead.
# PLAY_DATA_DIR=.data-testnet
